              "mode": "raw",
              "raw": "{\n  \"doctor_id\": 1,\n  \"duration\": 30,\n  \"appointment_time\": \"2030-01-30T14:00:00Z\",\n  \"reason\": \"Routine checkup\",\n  \"school_id\": 1,\n  \"student_id\": 1\n}"
